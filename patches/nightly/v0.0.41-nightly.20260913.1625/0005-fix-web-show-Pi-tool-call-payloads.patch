From 892b1519b40ac8300f131381c91249f1396006ae Mon Sep 17 00:00:00 2001
From: Brrock Agent <benjy@benjyross.xyz>
Date: Sun, 30 Aug 2026 10:30:45 +0100
Subject: [PATCH] fix(web): show Pi tool call payloads

---
 .../src/components/chat/MessagesTimeline.tsx  |  7 ++++--
 apps/web/src/session-logic.test.ts            | 25 +++++++++++++++++++
 apps/web/src/session-logic.ts                 |  9 +++++--
 3 files changed, 37 insertions(+), 4 deletions(-)

diff --git a/apps/web/src/components/chat/MessagesTimeline.tsx b/apps/web/src/components/chat/MessagesTimeline.tsx
index 568a86721..e3ebd3436 100644
--- a/apps/web/src/components/chat/MessagesTimeline.tsx
+++ b/apps/web/src/components/chat/MessagesTimeline.tsx
@@ -3651,8 +3651,11 @@ function buildToolCallExpandedBody(
     seen.add(text);
     blocks.push(text);
   };
-  if (workEntry.itemType === "mcp_tool_call" && workEntry.toolData !== undefined) {
-    addBlock(`MCP call\n${JSON.stringify(workEntry.toolData, null, 2)}`);
+  if (
+    (workEntry.itemType === "mcp_tool_call" || workEntry.itemType === "dynamic_tool_call") &&
+    workEntry.toolData !== undefined
+  ) {
+    addBlock(`Tool call\n${JSON.stringify(workEntry.toolData, null, 2)}`);
   }
   const command = workEntry.command?.trim();
   const raw = workEntryRawCommand(workEntry);
diff --git a/apps/web/src/session-logic.test.ts b/apps/web/src/session-logic.test.ts
index 2dbcaeeb7..c10f47910 100644
--- a/apps/web/src/session-logic.test.ts
+++ b/apps/web/src/session-logic.test.ts
@@ -926,6 +926,31 @@ describe("deriveWorkLogEntries", () => {
     },
   );
 
+  it("preserves Pi dynamic tool payloads for expanded display", () => {
+    const item = {
+      type: "tool_execution_end",
+      toolCallId: "pi-tool-1",
+      toolName: "bash",
+      args: { command: "git status" },
+      result: "On branch main",
+    };
+    const activities: OrchestrationThreadActivity[] = [
+      makeActivity({
+        id: "pi-tool-done",
+        kind: "tool.completed",
+        summary: "bash",
+        payload: {
+          itemType: "dynamic_tool_call",
+          title: "bash",
+          data: item,
+        },
+      }),
+    ];
+
+    const [entry] = deriveWorkLogEntries(activities);
+    expect(entry?.toolData).toEqual(item);
+  });
+
   it("keeps MCP payloads while collapsing lifecycle updates", () => {
     const item = {
       type: "mcpToolCall",
diff --git a/apps/web/src/session-logic.ts b/apps/web/src/session-logic.ts
index 6a0920681..9ec498139 100644
--- a/apps/web/src/session-logic.ts
+++ b/apps/web/src/session-logic.ts
@@ -627,9 +627,14 @@ function toDerivedWorkLogEntry(activity: OrchestrationThreadActivity): DerivedWo
   if (toolPresentation.toolSource) {
     entry.toolSource = toolPresentation.toolSource;
   }
-  if (itemType === "mcp_tool_call") {
+  if (itemType === "mcp_tool_call" || itemType === "dynamic_tool_call") {
     const data = asRecord(payload?.data);
-    const toolData = typeof data?.toolName === "string" ? (data.item ?? data) : data?.item;
+    const toolData =
+      itemType === "dynamic_tool_call"
+        ? payload?.data
+        : typeof data?.toolName === "string"
+          ? (data.item ?? data)
+          : data?.item;
     if (toolData !== undefined) {
       entry.toolData = toolData;
     }
