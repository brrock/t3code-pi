+export const T3_CODE_ORCHESTRATION_INSTRUCTIONS = `
+## T3 Code browser tools
+
+The \`t3-code\` MCP server provides app-owned collaborative browser-preview tools. Use its \`preview_*\` tools for browser navigation, inspection, interaction, screenshots, and recordings when the user asks for browser verification. The server does not provide subagent/delegation tools; do not claim or attempt to use them.
+`;
