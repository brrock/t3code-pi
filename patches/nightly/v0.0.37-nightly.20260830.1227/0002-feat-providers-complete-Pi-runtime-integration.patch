diff --git a/apps/server/src/provider/Layers/PiAdapter.test.ts b/apps/server/src/provider/Layers/PiAdapter.test.ts
new file mode 100644
index 000000000..564f21386
--- /dev/null
+++ b/apps/server/src/provider/Layers/PiAdapter.test.ts
@@ -0,0 +1,73 @@
+import { assert, it } from "@effect/vitest";
+
+import { piAssistantMessageDelta, piSubagentSignal } from "./PiAdapter.ts";
+import { T3_PI_SUBAGENT_WIDGET_KEY } from "../piT3McpExtensionSource.ts";
+
+it("maps Pi's delta field into distinct assistant and reasoning streams", () => {
+  assert.deepEqual(
+    piAssistantMessageDelta({
+      type: "message_update",
+      assistantMessageEvent: { type: "text_delta", delta: "hello" },
+    }),
+    { kind: "assistant", text: "hello" },
+  );
+  assert.deepEqual(
+    piAssistantMessageDelta({
+      type: "message_update",
+      assistantMessageEvent: { type: "thinking_delta", delta: "considering" },
+    }),
+    { kind: "reasoning", text: "considering" },
+  );
+});
+
+it("does not accept cumulative or finalized Pi message payloads as deltas", () => {
+  assert.isUndefined(
+    piAssistantMessageDelta({
+      type: "message_update",
+      assistantMessageEvent: { type: "text_end", content: "hello" },
+    }),
+  );
+  assert.isUndefined(
+    piAssistantMessageDelta({
+      type: "message_update",
+      assistantMessageEvent: { type: "text_delta", content: "hello" },
+    }),
+  );
+});
+
+it("recognizes lifecycle signals from the optional pi-subagents bridge", () => {
+  assert.deepEqual(
+    piSubagentSignal({
+      type: "extension_ui_request",
+      method: "setWidget",
+      widgetKey: T3_PI_SUBAGENT_WIDGET_KEY,
+      widgetLines: [
+        JSON.stringify({
+          version: 1,
+          name: "subagent:async-started",
+          runId: "run-1",
+          agent: "reviewer",
+          goal: "Review the diff",
+        }),
+      ],
+    }),
+    {
+      name: "subagent:async-started",
+      runId: "run-1",
+      agent: "reviewer",
+      goal: "Review the diff",
+      task: undefined,
+      state: undefined,
+      status: undefined,
+      error: undefined,
+    },
+  );
+  assert.isUndefined(
+    piSubagentSignal({
+      type: "extension_ui_request",
+      method: "setWidget",
+      widgetKey: "some-other-extension",
+      widgetLines: ['{"name":"subagent:async-started","runId":"run-1"}'],
+    }),
+  );
+});
