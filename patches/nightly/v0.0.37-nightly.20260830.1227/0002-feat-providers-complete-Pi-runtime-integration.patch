+import { describe, expect, it } from "@effect/vitest";
+
+import { buildPiRpcLaunch, resolvePiLaunchArgs } from "./piT3McpInjection.ts";
+import { PI_T3_MCP_EXTENSION_SOURCE } from "./piT3McpExtensionSource.ts";
+
+describe("Pi T3 MCP launch", () => {
+  it("injects only the active session credentials and clears inherited values", () => {
+    const parsed = resolvePiLaunchArgs('--model "openai/gpt-5"');
+    expect(parsed).toEqual({ ok: true, args: ["--model", "openai/gpt-5"] });
+    if (!parsed.ok) return;
+
+    const launch = buildPiRpcLaunch({
+      launchArgs: parsed.args,
+      environment: {
+        T3_MCP_URL: "http://stale.example/mcp",
+        T3_MCP_BEARER_TOKEN: "stale",
+        KEEP_ME: "yes",
+      },
+      mcpSession: {
+        environmentId: "environment" as never,
+        threadId: "thread" as never,
+        providerSessionId: "provider-session",
+        providerInstanceId: "pi" as never,
+        endpoint: "http://127.0.0.1:4141/mcp",
+        authorizationHeader: "Bearer fresh-token",
+      },
+      extensionPath: "/tmp/t3-pi-extension.ts",
+      runtimeMode: "approval-required",
+    });
+
+    expect(launch.hasT3Mcp).toBe(true);
+    expect(launch.args).toEqual([
+      "--mode",
+      "rpc",
+      "--model",
+      "openai/gpt-5",
+      "--extension",
+      "/tmp/t3-pi-extension.ts",
+    ]);
+    expect(launch.env).toMatchObject({
+      KEEP_ME: "yes",
+      T3_MCP_URL: "http://127.0.0.1:4141/mcp",
+      T3_MCP_BEARER_TOKEN: "fresh-token",
+      T3_PI_RUNTIME_MODE: "approval-required",
+    });
+  });
+
+  it("rejects T3-owned RPC and session flags", () => {
+    expect(resolvePiLaunchArgs("--session-id other")).toMatchObject({ ok: false });
+    expect(resolvePiLaunchArgs("--mode json")).toMatchObject({ ok: false });
+    expect(resolvePiLaunchArgs("hello")).toMatchObject({ ok: false });
+  });
+
+  it("loads the bridge without registering browser MCP tools when no desktop host is available", () => {
+    const launch = buildPiRpcLaunch({
+      launchArgs: [],
+      environment: {},
+      mcpSession: undefined,
+      extensionPath: "/tmp/t3-pi-extension.ts",
+    });
+
+    expect(launch.hasT3Mcp).toBe(false);
+    expect(launch.args).toContain("--extension");
+    expect(launch.env.T3_MCP_URL).toBeUndefined();
+    expect(launch.env.T3_MCP_BEARER_TOKEN).toBeUndefined();
+  });
+
+  it("forwards optional pi-subagents lifecycle signals without importing that package", () => {
+    expect(PI_T3_MCP_EXTENSION_SOURCE).toContain("subagent:async-started");
+    expect(PI_T3_MCP_EXTENSION_SOURCE).toContain("subagent:async-complete");
+    expect(PI_T3_MCP_EXTENSION_SOURCE).not.toContain('from "pi-subagents"');
+  });
+
+  it("asks T3 for a real approval and blocks a declined Pi tool call", () => {
+    expect(PI_T3_MCP_EXTENSION_SOURCE).toContain('pi.on("tool_call"');
+    expect(PI_T3_MCP_EXTENSION_SOURCE).toContain("ctx.ui.confirm(");
+    expect(PI_T3_MCP_EXTENSION_SOURCE).toContain("was declined in T3 Code");
+    expect(PI_T3_MCP_EXTENSION_SOURCE).not.toContain("confirmed: true");
+  });
+});
