+      // ── tools ─────────────────────────────────────────────
+
+      const emitToolItem = Effect.fnUntraced(function* (
+        turn: ActivePiTurn,
+        event: PiRpcRecord,
+        phase: "start" | "update" | "end",
+      ) {
